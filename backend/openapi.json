{
  "components": {
    "schemas": {
      "AuthResponse": {
        "properties": {
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "environment": {
            "const": "simulation",
            "default": "simulation",
            "title": "Environment",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "user",
          "capabilities",
          "csrf_token"
        ],
        "title": "AuthResponse",
        "type": "object"
      },
      "CsrfResponse": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "CsrfResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "details": {
            "items": {
              "type": "string"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "StatusResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "StatusResponse",
        "type": "object"
      },
      "TelegramLogin": {
        "additionalProperties": false,
        "properties": {
          "init_data": {
            "maxLength": 16384,
            "minLength": 1,
            "title": "Init Data",
            "type": "string"
          }
        },
        "required": [
          "init_data"
        ],
        "title": "TelegramLogin",
        "type": "object"
      },
      "UserResponse": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "customer",
              "owner"
            ],
            "title": "Role",
            "type": "string"
          },
          "telegram_id": {
            "title": "Telegram Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "telegram_id",
          "display_name",
          "role"
        ],
        "title": "UserResponse",
        "type": "object"
      }
    }
  },
