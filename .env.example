# Backend configuration template. Copy to an ignored .env.local file.
# Use isolated development/test data. Never put credentials in this file.
# All live capabilities stay disabled; changing flags cannot promote test records.
APP_ENV=development
SIMULATION_MODE=true
BINDING_QUOTES_ENABLED=false
AUTO_QUOTE_ENABLED=false
PAYMENT_POLICY_APPROVED=false
LIVE_PAYMENTS_ENABLED=false
REAL_PRINTING_ENABLED=false

# Backend/bot only; provision dedicated TEST values securely. Never paste them
# into chat, logs, source control or frontend environment variables.
# Never use VITE_ prefixes for secrets or owner provisioning.
BOT_TOKEN=
OWNER_TELEGRAM_IDS=
DATABASE_URL=
SESSION_SECRET=
PUBLIC_BASE_URL=

# Only needed by the optional local Docker Compose database. URL-encode special
# password characters if constructing DATABASE_URL manually.
POSTGRES_PASSWORD=

# Fixed absolute session lifetime; signed Telegram launch proof freshness.
SESSION_TTL_SECONDS=3600
AUTH_MAX_AGE_SECONDS=300
AUTH_FUTURE_SKEW_SECONDS=30
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
DEVELOPMENT_AUTH_ENABLED=false

# M04 private intake: never point storage at frontend/static directories.
# Docker image uses /srv/private_uploads and Compose persists a private volume.
STORAGE_ROOT=.local/private_models
UPLOAD_MAX_BYTES=26214400
REQUEST_STORAGE_BYTES=104857600
USER_STORAGE_BYTES=524288000
TOTAL_STORAGE_BYTES=2147483648
REQUEST_FILE_LIMIT=10
USER_FILE_LIMIT=100
TOTAL_FILE_LIMIT=10000
MAX_INFLIGHT_UPLOADS=2
UPLOAD_TIMEOUT_SECONDS=60
UPLOAD_LEASE_SECONDS=120
INTAKE_RATE_LIMIT=120
UPLOAD_RATE_LIMIT=10
INTAKE_RATE_WINDOW_SECONDS=60
ARCHIVE_ENTRY_LIMIT=64
ARCHIVE_EXPANDED_BYTES=67108864
ARCHIVE_ENTRY_BYTES=16777216
ARCHIVE_RATIO_LIMIT=100
VALIDATION_TIMEOUT_SECONDS=15
VALIDATION_CPU_SECONDS=5
