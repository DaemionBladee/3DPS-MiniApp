# M02 backend configuration template. Copy to an ignored .env.local file.
# Use isolated development/test data. Never put credentials in this file.
# All live capabilities stay disabled; changing flags cannot promote test records.
APP_ENV=development
SIMULATION_MODE=true
BINDING_QUOTES_ENABLED=false
AUTO_QUOTE_ENABLED=false
PAYMENT_POLICY_APPROVED=false
LIVE_PAYMENTS_ENABLED=false
REAL_PRINTING_ENABLED=false

# Backend/bot only; provision dedicated TEST values securely. Never paste them
# into chat, logs, source control or frontend environment variables.
# Never use VITE_ prefixes for secrets or owner provisioning.
BOT_TOKEN=
OWNER_TELEGRAM_IDS=
DATABASE_URL=
SESSION_SECRET=
PUBLIC_BASE_URL=

# Only needed by the optional local Docker Compose database. URL-encode special
# password characters if constructing DATABASE_URL manually.
POSTGRES_PASSWORD=

# Fixed absolute session lifetime; signed Telegram launch proof freshness.
SESSION_TTL_SECONDS=3600
AUTH_MAX_AGE_SECONDS=300
AUTH_FUTURE_SKEW_SECONDS=30
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
DEVELOPMENT_AUTH_ENABLED=false

# No upload/storage runtime exists. Configure private storage and approved
# conservative test quotas in M04; blank values must not mean unlimited uploads.
STORAGE_ROOT=
UPLOAD_MAX_MB=
